{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^7.10.0",
    "@tracklet /auth": "workspace:*",
    "@tracklet /db": "workspace:*",
    "better-auth": "catalog:",
    "exceljs": "^4.4.0",
    "hono": "^4.13.7",
    "pdf-lib": "^1.17.1",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tracklet /config": "workspace:*",
    "@tracklet /infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "unwasm": "^0.6.0"
  }
}
